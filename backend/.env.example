# ==========================================
# تنظیمات سرور ایمیل (SMTP Email Configuration)
# ==========================================
# برای ارسال واقعی ایمیل کد تأیید، این فایل را به نام .env ذخیره کرده
# و مشخصات جیمیل یا سرور SMTP خود را وارد کنید:

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# توجه: برای جیمیل باید از «App Password» (رمز عبور برنامه) استفاده کنید، نه رمز اصلی اکانت:
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com
SMTP_USE_TLS=true
